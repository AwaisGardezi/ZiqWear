# ZIQWEAR — environment template
#
# Locally, RUN-ZIQWEAR.bat copies this file to backend\.env on first run, so the
# defaults below are tuned for localhost. To deploy, copy this file to the server
# as backend/.env and change the three items marked PRODUCTION.
#
# Secrets stay out of git: backend/.env and the root .env are both ignored.

# --------------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Interface the API binds to. 0.0.0.0 is what the local launcher needs.
# PRODUCTION: set HOST=127.0.0.1 so nginx is the only thing that can reach it.
HOST=0.0.0.0

# -------------------------------------------------------------------- database
# The platform runs on SQLite — there is no database server to install.
# A relative file: URL resolves against backend/prisma/, where schema.prisma
# lives, so "./ziqwear.db" is backend/prisma/ziqwear.db.
# PRODUCTION: keep the same file, but back it up (see ZIQWEAR_BACKUP_DIR below).
DATABASE_URL="file:./ziqwear.db"

# ---------------------------------------------------------------------- origins
# Used for links inside emails and for redirect-after-login.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Only used when a browser calls this API from a *different* origin. Behind
# nginx on one domain the storefront and admin both call /api/v1 same-origin,
# so this can stay as-is. Blank or unset falls back to the localhost list.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8777

# ------------------------------------------------------------- signing keys
# PRODUCTION — REQUIRED. With NODE_ENV=production the server refuses to boot
# while either key is unset, shorter than 32 characters, or left as a template
# placeholder, because a known JWT_SECRET lets anyone mint an admin token.
# Generate one fresh value per deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-the-output-of-the-command-above-0000000000000000
COOKIE_SECRET=replace-me-with-the-output-of-the-command-above-1111111111111111

# ----------------------------------------------------------------------- email
# Order and contact notifications. Leave SMTP_USER/SMTP_PASS blank to run with
# email switched off — the site still works, nothing is sent.
# Gmail needs an App Password (https://myaccount.google.com/apppasswords), not
# the account password. Use 587 or 465: AWS blocks outbound port 25 by default.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ZIQWEAR <noreply@ziqwear.com>

# Two more keys are read by server.ps1 (the local static server), which looks in
# the root .env first and then backend/.env:
ZIQ_OWNER_EMAIL=Zohaib8muneer@gmail.com
ZIQ_STORE_NAME=ZIQWEAR

# --------------------------------------------------------------------- uploads
# Must be a writable directory on the deployed host.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# --------------------------------------------------------- backups and exports
# Used by `npm run backup` / `restore` / `export:*` in backend/.
ZIQWEAR_DB_SOURCE=prisma/ziqwear.db
ZIQWEAR_BACKUP_DIR=backups
ZIQWEAR_BACKUP_KEEP=14
ZIQWEAR_EXPORT_DIR=exports

# -------------------------------------------------------------- seed passwords
# Only read by `npm run db:seed`. Never set these in a public repository.
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=

# ------------------------------------------------- optional integrations (off)
# Everything below is disabled while its keys are blank. The store runs on
# cash-on-delivery and WhatsApp without any of them.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=pkr
# SENDGRID_API_KEY=
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_URL=https://graph.facebook.com/v20.0
# SMS_WEBHOOK_URL=
# SMS_API_KEY=

# ------------------------------------------------------------- production notes
# 1. NODE_ENV=production flips cookies to Secure and logging to combined.
# 2. Set FRONTEND_URL / ADMIN_URL to the real https:// addresses.
# 3. Replace both signing keys with freshly generated values.
# 4. Fill SMTP_USER / SMTP_PASS with a rotated Gmail App Password — the one in
#    earlier client packages was distributed in plaintext and must not be reused.
# 5. Do not run `prisma migrate dev` or `prisma db push` against a live
#    ziqwear.db; use `npx prisma generate` plus committed migrations.
