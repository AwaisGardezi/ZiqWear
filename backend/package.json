    "export:orders": "node scripts/export-orders.csv.mjs",
    "export:products": "node scripts/export-products.csv.mjs",
    "import:products": "node scripts/import-products.csv.mjs",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@sendgrid/mail": "^8.1.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
