{
  "name": "ziqwear-backend",
  "version": "1.0.0",
  "description": "ZIQWEAR Premium Streetwear E-Commerce Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
